<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header" style="background: var(--theme-primary); color: white;">
          <h5 class="mb-0">🐾 新しいポケモンを捕獲</h5>
          <small><%= @challenge.name %> - <%= @challenge.game_title_display %></small>
        </div>
        <div class="card-body">
          <%= form_with model: [@challenge, @pokemon], local: true, class: "row g-2" do |form| %>
            <% if @pokemon.errors.any? %>
              <div class="col-12">
                <div class="alert alert-danger py-2">
                  <strong>エラー:</strong>
                  <ul class="mb-0 small">
                    <% @pokemon.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            <% end %>

            <%# === 基本情報（常に表示） === %>
            <div class="col-md-6">
              <%= form.label :species, "ポケモンの種類 *", class: "form-label small fw-bold" %>
              <%= form.text_field :species, class: "form-control form-control-sm", placeholder: "例: ピカチュウ" %>
            </div>

            <div class="col-md-6">
              <%= form.label :nickname, "ニックネーム *", class: "form-label small fw-bold" %>
              <%= form.text_field :nickname, class: "form-control form-control-sm", placeholder: "例: でんきちゃん" %>
            </div>

            <div class="col-md-3">
              <%= form.label :level, "レベル *", class: "form-label small fw-bold" %>
              <%= form.number_field :level, class: "form-control form-control-sm", min: 1, max: 100, placeholder: "5" %>
            </div>

            <div class="col-md-3">
              <%= form.label :primary_type, "タイプ1 *", class: "form-label small fw-bold" %>
              <%= form.select :primary_type, 
                  options_for_select([['選択', '']] + TypeEffectiveness::POKEMON_TYPES.map { |t| [t.capitalize, t] }), 
                  {}, { class: "form-select form-select-sm" } %>
            </div>

            <div class="col-md-3">
              <%= form.label :secondary_type, "タイプ2", class: "form-label small" %>
              <%= form.select :secondary_type, 
                  options_for_select([['なし', '']] + TypeEffectiveness::POKEMON_TYPES.map { |t| [t.capitalize, t] }), 
                  {}, { class: "form-select form-select-sm" } %>
            </div>

            <div class="col-md-3">
              <%= form.label :gender, "性別", class: "form-label small" %>
              <%= form.select :gender, 
                  options_for_select([['選択', '']] + Pokemon::GENDERS.map { |g| [g, g] }), 
                  {}, { class: "form-select form-select-sm" } %>
            </div>

            <div class="col-12" data-controller="capture-check"
                 data-capture-check-caught-areas-value="<%= (@caught_areas || {}).to_json %>">
              <%= form.label :area_id, "捕獲場所 *", class: "form-label small fw-bold" %>
              <%= form.select :area_id, 
                  options_for_select(
                    [['捕獲場所を選択', '']] + @areas.map { |area| 
                      caught = @caught_areas&.dig(area.id)
                      label = if caught
                        "#{area.display_name} ⛔ #{caught[:name]}"
                      else
                        "#{area.display_name} ✅"
                      end
                      [label, area.id]
                    }
                  ), 
                  {}, 
                  { class: "form-select form-select-sm", 
                    data: { capture_check_target: "select", action: "change->capture-check#checkArea" } } %>
              <div class="alert alert-warning mt-1 py-1 d-none small" 
                   data-capture-check-target="warning" role="alert"></div>
            </div>

            <div class="col-md-4">
              <%= form.label :role, "役割 *", class: "form-label small fw-bold" %>
              <%= form.select :role, 
                  options_for_select(Pokemon.roles.map { |key, _| [Pokemon.human_enum_name(:role, key), key] }), 
                  {}, { class: "form-select form-select-sm" } %>
            </div>

            <div class="col-md-4">
              <%= form.label :nature, "性格", class: "form-label small" %>
              <%= form.select :nature, 
                  options_for_select([['選択', '']] + Pokemon::NATURES.map { |n| [n, n] }), 
                  {}, { class: "form-select form-select-sm" } %>
            </div>

            <div class="col-md-4">
              <%= form.label :ability, "特性", class: "form-label small" %>
              <%= form.text_field :ability, class: "form-control form-control-sm", placeholder: "例: せいでんき" %>
            </div>

            <div class="col-12">
              <div class="form-check">
                <%= form.check_box :in_party, class: "form-check-input" %>
                <%= form.label :in_party, "パーティに加える", class: "form-check-label small" %>
                <small class="text-muted">
                  <% if @challenge.party_slots_available == 0 %>
                    （満員）
                  <% else %>
                    （空き: <%= @challenge.party_slots_available %>）
                  <% end %>
                </small>
              </div>
            </div>

            <%# === メモ（折りたたみ） === %>
            <div class="col-12" data-controller="collapsible">
              <button type="button" class="btn btn-sm btn-outline-secondary w-100 text-start" 
                      data-action="click->collapsible#toggle">
                <span data-collapsible-target="icon">▶</span>
                📝 メモ・思い出（任意）
              </button>
              <div data-collapsible-target="content" class="mt-2">
                <div class="row g-2">
                  <div class="col-12">
                    <%= form.text_area :experience, class: "form-control form-control-sm", rows: 2, 
                        placeholder: "捕獲時の思い出（任意）" %>
                  </div>
                  <div class="col-12">
                    <%= form.text_area :notes, class: "form-control form-control-sm", rows: 2, 
                        placeholder: "戦略メモ（任意）" %>
                  </div>
                </div>
              </div>
            </div>

            <%# === IV/EV（折りたたみ） === %>
            <div class="col-12" data-controller="collapsible">
              <button type="button" class="btn btn-sm btn-outline-secondary w-100 text-start" 
                      data-action="click->collapsible#toggle">
                <span data-collapsible-target="icon">▶</span>
                🎯 個体値・努力値（上級者向け・任意）
              </button>
              <div data-collapsible-target="content" class="mt-2">
                <div class="card bg-light p-2 mb-2">
                  <small class="fw-bold text-info mb-1">個体値 (IVs) 0～31</small>
                  <div class="row g-1">
                    <% %w[hp attack defense special_attack special_defense speed].each_with_index do |stat, i| %>
                      <div class="col-4 col-md-2">
                        <%= form.label :"#{stat}_iv", %w[HP 攻撃 防御 特攻 特防 素早][i], class: "form-label small mb-0" %>
                        <%= form.number_field :"#{stat}_iv", class: "form-control form-control-sm", min: 0, max: 31, value: 0 %>
                      </div>
                    <% end %>
                  </div>
                </div>
                <div class="card bg-light p-2">
                  <small class="fw-bold text-warning mb-1">努力値 (EVs) 0～252</small>
                  <div class="row g-1">
                    <% %w[hp attack defense special_attack special_defense speed].each_with_index do |stat, i| %>
                      <div class="col-4 col-md-2">
                        <%= form.label :"#{stat}_ev", %w[HP 攻撃 防御 特攻 特防 素早][i], class: "form-label small mb-0" %>
                        <%= form.number_field :"#{stat}_ev", class: "form-control form-control-sm", min: 0, max: 252, value: 0 %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>

            <%# === 送信ボタン === %>
            <div class="col-12">
              <div class="d-flex gap-2 justify-content-end flex-wrap">
                <%= link_to "キャンセル", challenge_pokemons_path(@challenge), class: "btn btn-secondary btn-sm" %>
                <%= form.submit "✨ 捕獲！", class: "btn btn-success" %>
                <button type="submit" name="continue_capture" value="1" class="btn btn-outline-success btn-sm" title="捕獲して次のポケモンへ">
                  🔄 続けて捕獲
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
