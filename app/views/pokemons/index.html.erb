<div class="container my-4">
  <%# ===== ヘッダー ===== %>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h3 mb-0">🐾 <%= @challenge.name %></h1>
      <small class="text-muted"><%= @challenge.game_title_display %></small>
    </div>
    <div class="d-flex gap-2">
      <%= link_to new_challenge_pokemon_path(@challenge), class: "btn btn-success" do %>
        ✨ 捕獲
      <% end %>
      <%= link_to progress_challenge_path(@challenge), class: "btn btn-outline-warning" do %>
        🏆 進捗
      <% end %>
    </div>
  </div>

  <% if @pokemons.empty? %>
    <div class="text-center py-5">
      <div style="font-size: 4rem;">🐾</div>
      <h3 class="text-muted mt-3 mb-3">まだポケモンを捕獲していません</h3>
      <p class="text-muted mb-4">最初の仲間と出会って、ナズロックの旅を始めよう！</p>
      <%= link_to "最初の仲間を捕獲", new_challenge_pokemon_path(@challenge), class: "btn btn-success btn-lg" %>
    </div>
  <% else %>
    <%= render 'pokemons/pokemon_list',
        challenge: @challenge,
        party_pokemon: @party_pokemon,
        alive_pokemon: @alive_pokemon,
        dead_pokemon: @dead_pokemon,
        boxed_pokemon: @boxed_pokemon,
        badges: @badges,
        compact: false %>
  <% end %>
</div>
