<div class="card h-100 border-primary">
  <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-1">
    <span class="badge bg-light text-primary"><%= position %></span>
    <span class="badge bg-success small">
      <%= pokemon.status_icon %> <%= pokemon.status_display %>
    </span>
  </div>
  
  <div class="card-body py-2 px-3">
    <h6 class="card-title text-primary mb-1">
      <%= pokemon.nickname %>
      <small class="text-muted">(<%= pokemon.species %>)</small>
    </h6>
    
    <%# レベル ± ボタン（非同期） 📈 %>
    <div class="d-flex align-items-center gap-1 mb-1"
         data-controller="level"
         data-level-url-value="<%= update_level_challenge_pokemon_path(@challenge, pokemon) %>"
         data-level-level-value="<%= pokemon.level %>">
      <button class="btn btn-outline-secondary btn-sm px-1 py-0"
              style="font-size: 0.7rem; line-height: 1;"
              data-level-target="minusBtn"
              data-action="click->level#decrement"
              <%= 'disabled' if pokemon.level <= 1 %>
              title="レベルダウン">−</button>
      <strong class="text-primary" style="min-width: 42px; text-align: center;"
              data-level-target="display">Lv.<%= pokemon.level %></strong>
      <button class="btn btn-outline-primary btn-sm px-1 py-0"
              style="font-size: 0.7rem; line-height: 1;"
              data-level-target="plusBtn"
              data-action="click->level#increment"
              <%= 'disabled' if pokemon.level >= 100 %>
              title="レベルアップ">＋</button>
      <small class="text-muted ms-1"><%= pokemon.nature.present? ? pokemon.nature : '' %></small>
    </div>
    
    <% if pokemon.area %>
      <small class="text-muted"><strong>出身:</strong> <%= pokemon.area.display_name %></small>
    <% end %>
  </div>
  
  <div class="card-footer bg-transparent py-1">
    <div class="d-flex gap-1">
      <%= link_to "詳細", challenge_pokemon_path(@challenge, pokemon), 
          class: "btn btn-outline-primary btn-sm flex-fill" %>
      <%= button_to "外す", toggle_party_challenge_pokemon_path(@challenge, pokemon), 
          method: :patch,
          class: "btn btn-outline-warning btn-sm",
          title: "パーティから外す" %>
      <%= button_to "💀", mark_as_dead_challenge_pokemon_path(@challenge, pokemon), 
          method: :patch,
          class: "btn btn-outline-danger btn-sm",
          data: { turbo_confirm: "#{pokemon.nickname}の死亡を記録しますか？😢" },
          title: "死亡マーク" %>
    </div>
  </div>
</div>
