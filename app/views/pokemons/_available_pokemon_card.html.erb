<div class="card h-100">
  <div class="card-header d-flex justify-content-between align-items-center py-1">
    <span class="badge <%= pokemon.status_badge_class %> small">
      <%= pokemon.status_icon %> <%= pokemon.status_display %>
    </span>
    <small class="text-muted"><%= pokemon.caught_at.strftime('%m/%d') %></small>
  </div>
  
  <div class="card-body py-2 px-3">
    <h6 class="card-title mb-1">
      <%= pokemon.nickname %>
      <small class="text-muted">(<%= pokemon.species %>)</small>
    </h6>
    
    <%# レベル ± ボタン 📈 %>
    <div class="d-flex align-items-center gap-1 mb-1">
      <%= button_to update_level_challenge_pokemon_path(@challenge, pokemon, level: pokemon.level - 1),
          method: :patch, class: "btn btn-outline-secondary btn-sm px-1 py-0",
          style: "font-size: 0.7rem; line-height: 1;",
          disabled: pokemon.level <= 1, title: "レベルダウン" do %>
        −
      <% end %>
      <strong style="min-width: 42px; text-align: center;">Lv.<%= pokemon.level %></strong>
      <%= button_to update_level_challenge_pokemon_path(@challenge, pokemon, level: pokemon.level + 1),
          method: :patch, class: "btn btn-outline-primary btn-sm px-1 py-0",
          style: "font-size: 0.7rem; line-height: 1;",
          disabled: pokemon.level >= 100, title: "レベルアップ" do %>
        ＋
      <% end %>
      <small class="text-muted ms-1"><%= pokemon.nature.present? ? pokemon.nature : '' %></small>
    </div>
    
    <% if pokemon.area %>
      <small class="text-muted"><strong>出身:</strong> <%= pokemon.area.display_name %></small>
    <% end %>
  </div>
  
  <div class="card-footer bg-transparent py-1">
    <div class="d-flex gap-1">
      <%= link_to "詳細", challenge_pokemon_path(@challenge, pokemon), 
          class: "btn btn-outline-primary btn-sm flex-fill" %>
      <% if @challenge.can_add_to_party? %>
        <%= button_to "参加", toggle_party_challenge_pokemon_path(@challenge, pokemon), 
            method: :patch,
            class: "btn btn-success btn-sm",
            title: "パーティに参加" %>
      <% else %>
        <button class="btn btn-secondary btn-sm" disabled title="パーティが満員">満員</button>
      <% end %>
      <%= button_to "📦", mark_as_boxed_challenge_pokemon_path(@challenge, pokemon), 
          method: :patch,
          class: "btn btn-outline-secondary btn-sm",
          data: { turbo_confirm: "#{pokemon.nickname}をボックスに預けますか？" },
          title: "ボックスに預ける" %>
    </div>
  </div>
</div>
