<div class="card shadow mt-4">
  <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
    <h5 class="mb-0">🗺️ エリア捕獲状況マップ</h5>
    <% if areas.any? %>
      <span class="badge bg-light text-dark">
        <%= caught_by_area.keys.compact.count %> / <%= areas.count %> エリア
      </span>
    <% end %>
  </div>
  
  <div class="card-body">
    <% if areas.any? %>
      <%# 捕獲進捗バー %>
      <% caught_count = caught_by_area.keys.compact.count %>
      <% total_count = areas.count %>
      <% progress = total_count > 0 ? (caught_count.to_f / total_count * 100).round(1) : 0 %>
      <div class="mb-4">
        <div class="d-flex justify-content-between mb-1">
          <small class="text-muted">捕獲進捗</small>
          <small class="fw-bold"><%= progress %>%</small>
        </div>
        <div class="progress" style="height: 8px;">
          <div class="progress-bar bg-success" role="progressbar" style="width: <%= progress %>%"></div>
        </div>
      </div>

      <%# エリア一覧 %>
      <div class="area-capture-list">
        <% areas.each do |area| %>
          <% pokemon_in_area = caught_by_area[area.id]&.first %>
          <% is_caught = pokemon_in_area.present? %>
          
          <div class="area-capture-item d-flex align-items-center p-2 mb-2 rounded-3 <%= is_caught ? 'bg-success bg-opacity-10 border border-success border-opacity-25' : 'bg-light border border-secondary border-opacity-10' %>">
            <%# エリアアイコン & 名前 %>
            <div class="area-info flex-shrink-0" style="min-width: 180px;">
              <span class="me-1"><%= area.area_type_icon %></span>
              <strong class="<%= is_caught ? 'text-dark' : 'text-muted' %>"><%= area.name %></strong>
            </div>
            
            <%# 捕獲状況 %>
            <div class="capture-status flex-grow-1 ms-3">
              <% if is_caught %>
                <div class="d-flex align-items-center">
                  <span class="badge <%= pokemon_status_badge(pokemon_in_area.status) %> me-2">
                    <%= pokemon_status_icon(pokemon_in_area.status) %>
                  </span>
                  <span class="fw-bold"><%= pokemon_in_area.nickname %></span>
                  <small class="text-muted ms-2">(<%= pokemon_in_area.species %>)</small>
                  <small class="text-muted ms-2">Lv.<%= pokemon_in_area.level %></small>
                  <% if pokemon_in_area.primary_type.present? %>
                    <span class="badge bg-secondary bg-opacity-25 text-dark ms-2" style="font-size: 0.7em;">
                      <%= pokemon_in_area.primary_type %>
                    </span>
                  <% end %>
                  <% if pokemon_in_area.in_party? %>
                    <span class="ms-2" title="パーティメンバー">⭐</span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-muted fst-italic">
                  <span class="me-1">❓</span> 未捕獲
                </span>
              <% end %>
            </div>

            <%# 捕獲チェックマーク %>
            <div class="capture-check flex-shrink-0 ms-2">
              <% if is_caught %>
                <span class="text-success fs-5">✅</span>
              <% else %>
                <span class="text-muted fs-5">⬜</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# 凡例 %>
      <div class="mt-3 pt-3 border-top">
        <small class="text-muted">
          <span class="me-3">💚 生存</span>
          <span class="me-3">💀 死亡</span>
          <span class="me-3">📦 ボックス</span>
          <span class="me-3">⭐ パーティ</span>
          <span>❓ 未捕獲</span>
        </small>
      </div>
    <% else %>
      <div class="text-center py-4">
        <p class="text-muted mb-0">🗺️ このゲームのエリアデータがまだありません</p>
        <small class="text-muted">ポケモンを追加するとエリアが自動生成されます</small>
      </div>
    <% end %>
  </div>
</div>
