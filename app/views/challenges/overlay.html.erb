<div class="overlay-container">
  <%# バッジ進捗 🏆 %>
  <% if @badges.any? %>
    <div class="overlay-badges">
      <% @badges.each do |badge| %>
        <div class="overlay-badge <%= badge.completed? ? 'earned' : 'unearned' %>"
             title="<%= badge.name %>">
          🏅
        </div>
      <% end %>
    </div>
  <% end %>

  <%# 現在のパーティ 🛡️ %>
  <div class="overlay-title">🛡️ パーティ (<%= @party_pokemon.count %>/6)</div>
  <div class="overlay-party">
    <% @party_pokemon.each do |pokemon| %>
      <div class="overlay-pokemon">
        <div class="poke-name"><%= pokemon.nickname %></div>
        <div class="poke-species"><%= pokemon.species %></div>
        <div class="poke-level">Lv.<%= pokemon.level %></div>
      </div>
    <% end %>
    <% (6 - @party_pokemon.count).times do %>
      <div class="overlay-pokemon" style="opacity: 0.3; border-style: dashed;">
        <div class="poke-name">---</div>
        <div class="poke-species">空きスロット</div>
      </div>
    <% end %>
  </div>

  <%# 墓場 💀 %>
  <% if @dead_pokemon.any? %>
    <div class="overlay-graveyard">
      💀 犠牲: <%= @dead_pokemon.count %>匹
      <% @dead_pokemon.limit(8).each do |pokemon| %>
        <span class="grave-name ms-1"><%= pokemon.nickname %></span>
      <% end %>
      <% if @dead_pokemon.count > 8 %>
        <span class="ms-1">他<%= @dead_pokemon.count - 8 %>匹...</span>
      <% end %>
    </div>
  <% end %>
</div>
