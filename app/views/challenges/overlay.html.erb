<div class="overlay-container">
  <%# チャレンジ名 %>
  <div class="overlay-title">🎮 <%= @challenge.name %></div>

  <%# バッジ進捗 🏆 %>
  <% if @badges.any? %>
    <div class="overlay-badges">
      <% @badges.each do |badge| %>
        <div class="overlay-badge <%= badge.completed? ? 'earned' : 'unearned' %>"
             title="<%= badge.name %>">
          <%= badge.completed? ? '🏅' : '⚪' %>
        </div>
      <% end %>
      <span class="overlay-badge-count">
        <%= @badges.count(&:completed?) %>/<%= @badges.count %>
      </span>
    </div>
  <% end %>

  <%# 現在のパーティ 🛡️ %>
  <div class="overlay-party">
    <% @party_pokemon.each do |pokemon| %>
      <div class="overlay-pokemon">
        <span class="poke-name"><%= pokemon.nickname %></span>
        <span class="poke-species"><%= pokemon.species %></span>
        <span class="poke-level">Lv.<%= pokemon.level %></span>
      </div>
    <% end %>
    <% (6 - @party_pokemon.count).times do %>
      <div class="overlay-pokemon empty">
        <span class="poke-name">---</span>
      </div>
    <% end %>
  </div>

  <%# 墓場 💀 %>
  <% if @dead_pokemon.any? %>
    <div class="overlay-graveyard">
      💀 <span class="grave-count"><%= @dead_pokemon.count %></span>
      <% @dead_pokemon.limit(10).each do |pokemon| %>
        <span class="grave-name"><%= pokemon.nickname %></span>
      <% end %>
      <% if @dead_pokemon.count > 10 %>
        <span>+<%= @dead_pokemon.count - 10 %></span>
      <% end %>
    </div>
  <% end %>
</div>
