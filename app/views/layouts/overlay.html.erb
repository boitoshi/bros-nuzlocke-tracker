<!DOCTYPE html>
<html>
  <head>
    <title>Nuzlocke Overlay</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="refresh" content="30">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <style>
      /* OBS オーバーレイ専用スタイル */
      body {
        background: transparent !important;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', 'Hiragino Sans', 'Meiryo', sans-serif;
        overflow: hidden;
      }
      body.chroma-green { background: #00ff00 !important; }
      body.chroma-blue { background: #0000ff !important; }
      body.chroma-magenta { background: #ff00ff !important; }
      body.solid-dark { background: #1a1a2e !important; }

      .overlay-container {
        padding: 10px;
        max-width: 400px;
      }

      .overlay-title {
        font-size: 13px;
        font-weight: bold;
        color: #fff;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.9);
        margin-bottom: 6px;
        padding: 3px 8px;
        background: rgba(0,0,0,0.6);
        border-radius: 4px;
        display: inline-block;
      }

      .overlay-badges {
        display: flex;
        align-items: center;
        gap: 3px;
        margin-bottom: 6px;
        padding: 4px 8px;
        background: rgba(0,0,0,0.5);
        border-radius: 4px;
      }
      .overlay-badge {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
      }
      .overlay-badge.earned {
        background: rgba(255,215,0,0.8);
        border: 2px solid #ffd700;
      }
      .overlay-badge.unearned {
        background: rgba(100,100,100,0.4);
        border: 1px solid rgba(100,100,100,0.3);
        opacity: 0.35;
      }
      .overlay-badge-count {
        color: #ffd700;
        font-size: 11px;
        font-weight: bold;
        margin-left: 4px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
      }

      .overlay-party {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-bottom: 6px;
      }
      .overlay-pokemon {
        background: rgba(0,0,0,0.6);
        border-left: 3px solid #4dabf7;
        border-radius: 3px;
        padding: 4px 8px;
        color: #fff;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
      }
      .overlay-pokemon.empty {
        opacity: 0.25;
        border-left-color: #666;
        border-style: dashed;
      }
      .overlay-pokemon .poke-name {
        font-weight: bold;
        font-size: 13px;
        min-width: 70px;
      }
      .overlay-pokemon .poke-species {
        font-size: 11px;
        opacity: 0.7;
        flex: 1;
      }
      .overlay-pokemon .poke-level {
        font-size: 12px;
        color: #ffd700;
        font-weight: bold;
      }

      .overlay-graveyard {
        background: rgba(0,0,0,0.5);
        border-left: 3px solid #ff6b6b;
        border-radius: 3px;
        padding: 4px 8px;
        color: #ff8787;
        font-size: 11px;
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        align-items: center;
      }
      .grave-count {
        font-weight: bold;
        margin-right: 4px;
      }
      .overlay-graveyard .grave-name {
        opacity: 0.7;
        text-decoration: line-through;
      }

      /* フッター非表示 */
      footer, .navbar, .toast-container-custom, .page-content { display: none !important; }
    </style>
  </head>

  <body class="<%= params[:bg] || '' %>">
    <%= yield %>
  </body>
</html>
