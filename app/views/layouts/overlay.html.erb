<!DOCTYPE html>
<html>
  <head>
    <title>Nuzlocke Overlay</title>
    <meta charset="utf-8">
    <meta http-equiv="refresh" content="30">
    <%= csrf_meta_tags %>
    <style>
      <%# 
        OBSオーバーレイ用の最小CSS
        _pokemon_list.html.erb のcompact=true表示をスタイリング
      %>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: transparent;
        font-family: 'Segoe UI', 'Hiragino Sans', sans-serif;
        color: #fff;
        overflow: hidden;
      }
      body.chroma-green { background: #00ff00 !important; }
      body.solid-dark { background: #1a1a2e !important; }

      .ov-container { padding: 8px; max-width: 320px; }
      .ov-title {
        padding: 3px 8px;
        background: rgba(0,0,0,0.7);
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        margin-bottom: 5px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
      }

      /* バッジバー */
      .ov-badges-bar {
        padding: 3px 8px;
        background: rgba(0,0,0,0.5);
        border-radius: 4px;
        font-size: 10px;
        font-weight: bold;
        color: #ffd700;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        gap: 3px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
      }
      .ov-badge-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        display: inline-block;
      }
      .ov-badge-dot.on { background: #ffd700; }
      .ov-badge-dot.off { background: rgba(100,100,100,0.4); opacity: 0.3; }

      /* パーティリスト */
      .ov-section { margin-bottom: 5px; }
      .ov-list { display: flex; flex-direction: column; gap: 2px; }

      .ov-row {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 2px 8px;
        background: rgba(0,0,0,0.6);
        border-radius: 3px;
        font-size: 12px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
      }
      .ov-party-row { border-left: 3px solid #4dabf7; }
      .ov-sprite { width: 28px; height: 28px; image-rendering: pixelated; }
      .sprite-fallback { display: none !important; }
      .ov-name { flex: 1; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .ov-lv { color: #ffd700; font-weight: bold; font-size: 11px; }

      /* 墓場 */
      .ov-graveyard {
        background: rgba(0,0,0,0.5);
        border-left: 3px solid #ff6b6b;
        border-radius: 3px;
        padding: 3px 8px;
        font-size: 10px;
        color: #ff8787;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 3px;
        text-shadow: 1px 1px 1px rgba(0,0,0,0.5);
      }
      .ov-dead-sprite { width: 20px; height: 20px; filter: grayscale(100%); opacity: 0.5; image-rendering: pixelated; }
      .ov-dead-more { opacity: 0.6; }
    </style>
  </head>
  <body class="<%= params[:bg] %>">
    <%= yield %>
  </body>
</html>
