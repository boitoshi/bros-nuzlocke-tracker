#!/bin/bash
# =============================================================================
# Bros Nuzlocke Tracker - Cloud Run 初回セットアップスクリプト 🚀
# GCPプロジェクトの作成からデプロイまでの手順を自動化
# =============================================================================
set -e

# カラー出力
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}=========================================="
echo "🚀 Bros Nuzlocke Tracker"
echo "   Cloud Run セットアップスクリプト"
echo -e "==========================================${NC}"

# =============================================================================
# 前提条件チェック
# =============================================================================
echo ""
echo -e "${YELLOW}📋 前提条件チェック...${NC}"

# gcloud CLIの確認
if ! command -v gcloud &> /dev/null; then
  echo -e "${RED}❌ gcloud CLI がインストールされていません${NC}"
  echo "   インストール: https://cloud.google.com/sdk/docs/install"
  exit 1
fi
echo -e "${GREEN}  ✅ gcloud CLI: $(gcloud --version 2>&1 | head -1)${NC}"

# Docker の確認
if ! command -v docker &> /dev/null; then
  echo -e "${RED}❌ Docker がインストールされていません${NC}"
  echo "   インストール: https://docs.docker.com/get-docker/"
  exit 1
fi
echo -e "${GREEN}  ✅ Docker: $(docker --version)${NC}"

# =============================================================================
# GCPプロジェクト設定
# =============================================================================
echo ""
echo -e "${YELLOW}🔧 GCPプロジェクト設定...${NC}"

# 認証チェック
ACCOUNT=$(gcloud auth list --filter=status:ACTIVE --format="value(account)" 2>/dev/null)
if [ -z "$ACCOUNT" ]; then
  echo "  Google Cloudにログインしてください..."
  gcloud auth login
else
  echo -e "${GREEN}  ✅ ログイン済み: ${ACCOUNT}${NC}"
fi

# プロジェクトID設定
CURRENT_PROJECT=$(gcloud config get-value project 2>/dev/null)
if [ -z "$CURRENT_PROJECT" ] || [ "$CURRENT_PROJECT" = "(unset)" ]; then
  echo ""
  echo -e "${YELLOW}  GCPプロジェクトIDを入力してください:${NC}"
  read -r PROJECT_ID
  gcloud config set project "$PROJECT_ID"
else
  echo -e "${GREEN}  ✅ プロジェクト: ${CURRENT_PROJECT}${NC}"
  echo -e "  別のプロジェクトを使う場合はプロジェクトIDを入力（Enterでスキップ）:"
  read -r NEW_PROJECT_ID
  if [ -n "$NEW_PROJECT_ID" ]; then
    gcloud config set project "$NEW_PROJECT_ID"
    CURRENT_PROJECT="$NEW_PROJECT_ID"
  fi
  PROJECT_ID="$CURRENT_PROJECT"
fi

# リージョン設定
REGION="asia-northeast1"
gcloud config set run/region "$REGION"
echo -e "${GREEN}  ✅ リージョン: ${REGION}（東京）${NC}"

# =============================================================================
# 必要なAPIを有効化
# =============================================================================
echo ""
echo -e "${YELLOW}🔌 必要なAPIを有効化中...${NC}"

APIS=(
  "run.googleapis.com"
  "cloudbuild.googleapis.com"
  "artifactregistry.googleapis.com"
  "secretmanager.googleapis.com"
)

for api in "${APIS[@]}"; do
  echo -n "  ${api}... "
  gcloud services enable "$api" 2>/dev/null && echo -e "${GREEN}✅${NC}" || echo -e "${YELLOW}(既に有効)${NC}"
done

# =============================================================================
# Artifact Registry リポジトリ作成
# =============================================================================
echo ""
echo -e "${YELLOW}📦 Artifact Registryリポジトリ作成...${NC}"

REPOSITORY="bros-nuzlocke-tracker"
if gcloud artifacts repositories describe "$REPOSITORY" --location="$REGION" &>/dev/null; then
  echo -e "${GREEN}  ✅ リポジトリ '${REPOSITORY}' は既に存在します${NC}"
else
  gcloud artifacts repositories create "$REPOSITORY" \
    --repository-format=docker \
    --location="$REGION" \
    --description="Bros Nuzlocke Tracker Docker images"
  echo -e "${GREEN}  ✅ リポジトリ '${REPOSITORY}' を作成しました${NC}"
fi

# =============================================================================
# Secret Manager にシークレット登録
# =============================================================================
echo ""
echo -e "${YELLOW}🔒 Secret Manager設定...${NC}"

# SECRET_KEY_BASE
if gcloud secrets describe SECRET_KEY_BASE &>/dev/null 2>&1; then
  echo -e "${GREEN}  ✅ SECRET_KEY_BASE は既に登録済み${NC}"
else
  echo "  SECRET_KEY_BASEを生成して登録します..."
  # Rubyが使えない場合はopensslで生成
  SECRET_KEY=$(openssl rand -hex 64)
  echo -n "$SECRET_KEY" | gcloud secrets create SECRET_KEY_BASE --data-file=-
  echo -e "${GREEN}  ✅ SECRET_KEY_BASE を登録しました${NC}"
fi

# DATABASE_URL
if gcloud secrets describe DATABASE_URL &>/dev/null 2>&1; then
  echo -e "${GREEN}  ✅ DATABASE_URL は既に登録済み${NC}"
else
  echo ""
  echo -e "${YELLOW}  Supabase DATABASE_URLを入力してください:${NC}"
  echo "  形式: postgres://postgres.xxxxx:PASSWORD@host:6543/postgres?sslmode=require"
  read -r DATABASE_URL
  echo -n "$DATABASE_URL" | gcloud secrets create DATABASE_URL --data-file=-
  echo -e "${GREEN}  ✅ DATABASE_URL を登録しました${NC}"
fi

# RAILS_MASTER_KEY
if gcloud secrets describe RAILS_MASTER_KEY &>/dev/null 2>&1; then
  echo -e "${GREEN}  ✅ RAILS_MASTER_KEY は既に登録済み${NC}"
else
  if [ -f "config/master.key" ]; then
    gcloud secrets create RAILS_MASTER_KEY --data-file=config/master.key
    echo -e "${GREEN}  ✅ RAILS_MASTER_KEY を config/master.key から登録しました${NC}"
  else
    echo -e "${YELLOW}  ⚠️  config/master.key が見つかりません${NC}"
    echo "  RAILS_MASTER_KEYを入力してください（Enterでスキップ）:"
    read -r MASTER_KEY
    if [ -n "$MASTER_KEY" ]; then
      echo -n "$MASTER_KEY" | gcloud secrets create RAILS_MASTER_KEY --data-file=-
      echo -e "${GREEN}  ✅ RAILS_MASTER_KEY を登録しました${NC}"
    else
      echo -e "${YELLOW}  ⏭️  RAILS_MASTER_KEY はスキップしました${NC}"
    fi
  fi
fi

# =============================================================================
# Cloud Build / Cloud Run サービスアカウント権限設定
# =============================================================================
echo ""
echo -e "${YELLOW}🔑 サービスアカウント権限設定...${NC}"

PROJECT_NUMBER=$(gcloud projects describe "$PROJECT_ID" --format='value(projectNumber)')
CB_SA="${PROJECT_NUMBER}@cloudbuild.gserviceaccount.com"
CR_SA="${PROJECT_NUMBER}-compute@developer.gserviceaccount.com"

# Cloud Build → Cloud Run 管理者
gcloud projects add-iam-policy-binding "$PROJECT_ID" \
  --member="serviceAccount:${CB_SA}" \
  --role="roles/run.admin" \
  --quiet 2>/dev/null
echo -e "${GREEN}  ✅ Cloud Build → Cloud Run 管理者権限${NC}"

# Cloud Build → サービスアカウントUser
gcloud projects add-iam-policy-binding "$PROJECT_ID" \
  --member="serviceAccount:${CB_SA}" \
  --role="roles/iam.serviceAccountUser" \
  --quiet 2>/dev/null
echo -e "${GREEN}  ✅ Cloud Build → サービスアカウントUser権限${NC}"

# Cloud Build → Secret Manager アクセス
gcloud projects add-iam-policy-binding "$PROJECT_ID" \
  --member="serviceAccount:${CB_SA}" \
  --role="roles/secretmanager.secretAccessor" \
  --quiet 2>/dev/null
echo -e "${GREEN}  ✅ Cloud Build → Secret Manager アクセス権限${NC}"

# Cloud Run サービスアカウント → Secret Manager アクセス
gcloud projects add-iam-policy-binding "$PROJECT_ID" \
  --member="serviceAccount:${CR_SA}" \
  --role="roles/secretmanager.secretAccessor" \
  --quiet 2>/dev/null
echo -e "${GREEN}  ✅ Cloud Run → Secret Manager アクセス権限${NC}"

# =============================================================================
# 完了メッセージ
# =============================================================================
echo ""
echo -e "${BLUE}=========================================="
echo "🎉 セットアップ完了！"
echo "==========================================${NC}"
echo ""
echo "次のステップ:"
echo -e "  ${GREEN}1.${NC} デプロイ実行:"
echo "     gcloud builds submit --config cloudbuild.yaml"
echo ""
echo -e "  ${GREEN}2.${NC} デプロイ確認:"
echo "     gcloud run services describe bros-nuzlocke-tracker --region ${REGION}"
echo ""
echo -e "  ${GREEN}3.${NC} ログ確認:"
echo "     gcloud run services logs read bros-nuzlocke-tracker --region ${REGION}"
echo ""
echo -e "  ${GREEN}4.${NC} サービスURL確認:"
echo "     gcloud run services describe bros-nuzlocke-tracker --region ${REGION} --format='value(status.url)'"
echo ""
echo -e "${YELLOW}💡 Tip: 初回ビルドには5〜10分かかります${NC}"
echo ""
